version: 6

orders:
  base:
    raindex: base
    inputs:
      - token: token1
    outputs:
      - token: token2

scenarios:
  st0x-swap-unwrap:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      erc4626-words: 0x0d09364EFa7753e53c9101715E7597E660E2919B
      io-fn: '''st0x-swap-unwrap'
  st0x-swap-wrap:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      erc4626-words: 0x0d09364EFa7753e53c9101715E7597E660E2919B
      io-fn: '''st0x-swap-wrap'

deployments:
  base-unwrap:
    order: base
    scenario: st0x-swap-unwrap
  base-wrap:
    order: base
    scenario: st0x-swap-wrap

builder:
  name: ST0x wrap / unwrap
  description: Convert between tSTOX and wtSTOX at the live on-chain vault rate.
  short-description: Put in one token and get the other out at the vault conversion rate.
  deployments:
    base-unwrap:
      name: Unwrap wtSTOX to tSTOX
      description: >
        Put in wtSTOX, get tSTOX out.
        Input token is wtSTOX (what you deposit). Output token is tSTOX (what you receive).
      deposits:
        - token: token2
      fields:
        - binding: multiplier
          name: Rate multiplier
          description: >
            Extra multiplier on the vault unwrap rate. Use 1 for the exact on-chain
            conversion rate; above 1 asks for more tSTOX per wtSTOX put in.
          show-custom-field: true
          default: 1
          min: 0.000001
          presets:
            - name: Exact vault rate (1x)
              value: 1
            - name: 1.001x
              value: 1.001
            - name: 1.005x
              value: 1.005
      select-tokens:
        - key: token1
          name: Output token (tSTOX)
          description: Token you get out. Select tSTOX.
        - key: token2
          name: Input token (wtSTOX)
          description: Token you put in. Select wtSTOX.
    base-wrap:
      name: Wrap tSTOX to wtSTOX
      description: >
        Put in tSTOX, get wtSTOX out.
        Input token is tSTOX (what you deposit). Output token is wtSTOX (what you receive).
      deposits:
        - token: token2
      fields:
        - binding: multiplier
          name: Rate multiplier
          description: >
            Extra multiplier on the vault wrap rate. Use 1 for the exact on-chain
            conversion rate; above 1 asks for more wtSTOX per tSTOX put in.
          show-custom-field: true
          default: 1
          min: 0.000001
          presets:
            - name: Exact vault rate (1x)
              value: 1
            - name: 1.001x
              value: 1.001
            - name: 1.005x
              value: 1.005
      select-tokens:
        - key: token1
          name: Output token (wtSTOX)
          description: Token you get out. Select wtSTOX.
        - key: token2
          name: Input token (tSTOX)
          description: Token you put in. Select tSTOX.
---
#raindex-subparser !The subparser to use.
#erc4626-words !St0x words (ERC4626 convert).
#io-fn !IO function binding (unwrap or wrap variant).
#multiplier !Extra multiplier on the vault conversion rate.

#st0x-swap-unwrap
  wrap-ratio: erc4626-convert-to-assets(output-token() 1),
  :ensure(
    greater-than(wrap-ratio 0)
    "Unwrap ratio zero"
  ),
  _: wrap-ratio;

#st0x-swap-wrap
  wrap-ratio: erc4626-convert-to-shares(output-token() 1),
  :ensure(
    greater-than(wrap-ratio 0)
    "Wrap ratio zero"
  ),
  _: wrap-ratio;

#calculate-io
using-words-from raindex-subparser erc4626-words
max-output: max-positive-value(),
io: mul(
  call<'io-fn>()
  multiplier
);

#handle-io
:;

#handle-add-order
:;
